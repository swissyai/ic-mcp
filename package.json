{
  "name": "ic-mcp",
  "version": "0.13.5",
  "description": "MCP server for building on the Internet Computer with icp-cli: official guidance by section, local deploys with confirmations, dfx.json conversion, Motoko checks through mops",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ic-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "prepublishOnly": "bash scripts/verify-version-alignment.sh && npm run build && npm run measure-tokens",
    "measure-tokens": "tsx src/utils/measure-tokens.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "internet-computer",
    "icp",
    "icp-cli",
    "mops",
    "motoko",
    "rust",
    "candid",
    "dfinity",
    "model-context-protocol",
    "toon",
    "natural-language",
    "ai-agent",
    "claude-code"
  ],
  "author": "swissyai (https://x.com/swissyai)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swissyai/ic-mcp.git"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@vitest/ui": "^4.0.2",
    "gpt-tokenizer": "^3.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.2"
  },
  "dependencies": {
    "@byjohann/toon": "^0.3.1",
    "@modelcontextprotocol/sdk": "^1.20.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  }
}
